{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./apps/web/src/*"],
      "@shared/*": ["./packages/shared/*"]
    },
    "tsBuildInfoFile": "./node_modules/.cache/tsbuildinfo"
  },
  "include": [
    "apps/web/src/**/*",
    "apps/api/**/*",
    "packages/shared/**/*"
  ],
  "exclude": ["node_modules", "dist", "build"]
}
